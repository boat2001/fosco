{
  "name": "fosco",
  "version": "1.0.0",
  "private": true,
  "description": "Foso College of Education — React + Express rebuild",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "start": "npm run start --workspace server",
    "scrape:pages": "node scripts/scrape-pages.mjs",
    "scrape:images": "node scripts/scrape-images.mjs",
    "scrape:news": "node scripts/scrape-news.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "extract": "node scripts/extract-content.mjs && node scripts/extract-gallery.mjs",
    "check:media": "node scripts/check-media.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "node-html-parser": "^9.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
