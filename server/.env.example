# Copy to server/.env and set real values before deploying.

# Signs admin session cookies. REQUIRED in production — the server refuses to
# issue sessions without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Initial admin account, created by `npm run seed` on first run only.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-deploying

PORT=4000
NODE_ENV=production
